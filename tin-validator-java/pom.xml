<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.captin</groupId>
        <artifactId>tin-validator</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>tin-validator-java</artifactId>
    <version>0.1.0</version>

    <url>https://github.com/captinbv/tin-validator</url>
    <name>Captin - Java TIN Validator - Java module</name>
    <description>
        TIN Validator provides Tax Identification Number (TIN) validation for both Java and JavaScript,
        allowing the same validation rules to be used consistently across back-end and front-end applications.
        This open-source project is currently supported by Captin B.V.

        This is the Java version.
    </description>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>renzo.slijp</id>
            <name>Renzo Slijp</name>
            <organization>Captin B.V.</organization>
            <email>renzo.slijp@captin.nl</email>
        </developer>
        <developer>
            <id>swati.kumari</id>
            <name>Swati Kumari</name>
            <organization>Captin B.V.</organization>
            <email>swati.kumari@captin.nl</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/captinbv/tin-validator.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/captinbv/tin-validator.git</developerConnection>
        <url>https://github.com/captinbv/tin-validator</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <jetbrains.annotations.version>24.1.0</jetbrains.annotations.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>${jetbrains.annotations.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

        </plugins>
    </build>

</project>